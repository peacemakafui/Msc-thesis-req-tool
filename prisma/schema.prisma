// This is your Prisma schema file for MSc Thesis Research Project
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User profile
  organization String?
  experience   Int?       // Years of experience
  position     String?

  // Trello integration credentials (legacy — export now uses server-side env vars)
  trelloApiKey String?
  trelloToken  String?

  // Rate limiting: daily counts reset each UTC day; lifetime counts never reset.
  // usageResetDate is always normalised to UTC midnight so it can be compared
  // for equality in atomic conditional updates (see src/lib/rateLimit.ts).
  dailyChatCount   Int       @default(0)
  dailyUploadCount Int       @default(0)
  dailyExportCount Int       @default(0)
  usageResetDate   DateTime?
  totalChatCount   Int       @default(0)
  totalUploadCount Int       @default(0)
  totalExportCount Int       @default(0)

  // Backstop across every metered LLM operation, regardless of kind.
  totalLlmCalls Int @default(0)

  // Set true to cut a participant off without deleting their data. Enforced in
  // requireAuth() (every API route) and in the dashboard layout, not just at the
  // quota layer, so a suspended account cannot use the app at all.
  blocked       Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String?
  /** Email of the admin who last changed the block state — a light audit trail. */
  blockedBy     String?

  // NextAuth fields
  emailVerified DateTime?
  image         String?
  accounts      Account[]

  // User projects and sessions
  projects    Project[]
  sessions    AppSession[]
  interactions UserInteraction[]
  chatMessages ChatMessage[]
  llmUsage     LlmUsage[]

  @@map("users")
}

/**
 * One row per provider request, written by src/lib/llm.ts.
 *
 * The counters on User bound how many calls a participant may make; this table
 * records what those calls actually cost. It is append-only and deliberately
 * separate from the counters: a fallback chain can make three provider requests
 * for one metered "call", and each one spends tokens that need accounting for.
 *
 * Failed attempts are recorded too (success = false) — a provider can burn input
 * tokens and then error, so leaving failures out would understate spend.
 */
model LlmUsage {
  id       String  @id @default(cuid())
  provider String // gemini | openai | anthropic
  model    String
  /** Which app operation the call belongs to: chat, document, pdf, srs, subtasks. */
  kind     String

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  /** Derived at write time from the model's published per-token price, in USD. */
  costUsd          Float @default(0)

  success      Boolean @default(true)
  /** Provider error class, when the call failed. Never the raw message. */
  error        String?
  responseTime Int? // milliseconds

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("llm_usage")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Single-row table holding the deployment-wide daily LLM call count. This is the
// backstop that caps total spend even if many accounts are created.
model GlobalUsage {
  id        String   @id @default("global")
  day       String // UTC date, YYYY-MM-DD
  llmCalls  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("global_usage")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Trello integration
  trelloBoardId  String?
  trelloBoardUrl String?

  // Project documents and requirements
  documents    Document[]
  requirements Requirement[]
  sessions     AppSession[]
  chatMessages ChatMessage[]

  @@map("projects")
}

model Document {
  id           String      @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  filePath     String
  status       DocStatus   @default(UPLOADED)
  processedAt  DateTime?
  createdAt    DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Document processing results
  extractedText String?
  requirements  Requirement[]

  // Number of LLM analysis runs against this document, to bound retries.
  analysisAttempts Int @default(0)

  @@map("documents")
}

model Requirement {
  id          String      @id @default(cuid())
  title       String
  description String
  type        ReqType
  priority    Priority    @default(MEDIUM)
  status      ReqStatus   @default(DRAFT)
  source      ReqSource
  confidence  Float?      // LLM confidence score
  sourceText  String?     // Supporting quote from the source document, for traceability
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  // LLM processing metadata
  llmModel    String?
  processing  ProcessingMetadata[]

  @@map("requirements")
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  role      MessageRole // USER or ASSISTANT
  projectId String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // LLM processing metadata
  llmModel    String?
  tokens      Int?
  responseTime Int? // milliseconds

  @@map("chat_messages")
}

model AppSession {
  id        String      @id @default(cuid())
  type      SessionType
  startTime DateTime    @default(now())
  endTime   DateTime?
  duration  Int?        // in seconds

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Session analytics
  interactions UserInteraction[]
  analytics    SessionAnalytics?

  @@map("app_sessions")
}

model UserInteraction {
  id        String          @id @default(cuid())
  action    InteractionType
  target    String         // What was interacted with
  metadata  Json?          // Additional interaction data
  timestamp DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String
  session   AppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("user_interactions")
}

model SessionAnalytics {
  id                    String @id @default(cuid())
  documentsProcessed    Int    @default(0)
  requirementsGenerated Int    @default(0)
  speechToTextUsed      Int    @default(0)
  llmCallsCount         Int    @default(0)
  averageResponseTime   Float? // milliseconds
  errorCount            Int    @default(0)

  sessionId String  @unique
  session   AppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_analytics")
}

model ProcessingMetadata {
  id            String   @id @default(cuid())
  processingType ProcessingType
  model         String
  tokens        Int?
  responseTime  Int?     // milliseconds
  success       Boolean
  error         String?
  createdAt     DateTime @default(now())

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("processing_metadata")
}

// Enums
enum UserRole {
  ADMIN
  USER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum DocStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ERROR
}

enum ReqType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  USER_STORY
  ACCEPTANCE_CRITERIA
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReqStatus {
  DRAFT
  REVIEWED
  APPROVED
  REJECTED
}

enum ReqSource {
  DOCUMENT_UPLOAD
  CHAT_INPUT
  MANUAL_INPUT
  LLM_GENERATED
}

enum SessionType {
  DOCUMENT_UPLOAD
  REQUIREMENTS_GENERATION
  CHAT_SESSION
  MANUAL_CREATION
}

enum InteractionType {
  CLICK
  SCROLL
  FORM_SUBMIT
  FILE_UPLOAD
  CHAT_MESSAGE
  REQUIREMENT_EDIT
  EXPORT
}

enum ProcessingType {
  LLM_ANALYSIS
  TEXT_EXTRACTION
  SPEECH_TO_TEXT
  CHAT_PROCESSING
}
